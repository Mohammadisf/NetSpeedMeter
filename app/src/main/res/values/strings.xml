    <!-- Data limit enforcement (automatic disconnection) -->
    <string name="enforce_limits">Disconnect automatically when the limit is exceeded</string>
    <string name="enforce_unsupported_note">Direct disconnect is not available on this device — Android does not let apps switch network connections on/off. When a limit is exceeded, the app instead blocks this device\'s internet with a built-in kill switch (VPN), so nothing can keep using data. You\'ll be asked once to allow the VPN.</string>
    <string name="limit_notif_title">Data limit reached</string>
    <string name="limit_notif_text">%1$s limit reached — %2$s used of %3$s</string>
    <string name="limit_disconnected"> Connection turned off automatically.</string>
    <string name="limit_blocked_vpn"> Internet blocked automatically (built-in kill switch).</string>
    <string name="limit_disconnect_failed"> Automatic disconnection was not possible on this device — turn it off manually.</string>
    <string name="limit_hotspot_blocked_vpn"> Hotspot clients\' internet blocked automatically (built-in kill switch); Android does not allow switching the access point itself off.</string>
    <string name="limit_monitor_hint">Monitoring runs while the speed service runs. Each limit re-arms when its period ends.</string>
    <string name="hotspot_usage_note">Hotspot counters are hidden from apps on some Android versions (e.g. Android 16); the app then reads the hotspot usage through the system\'s Usage data access. You\'ll be asked once to grant it.</string>

    <!-- Enforcement kill-switch VPN -->
    <string name="enforce_vpn_channel">Connection enforcement</string>

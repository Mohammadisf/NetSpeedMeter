    <string name="hotspot_alert_title">Hotspot data alert</string>
    <string name="hotspot_alert_text">%1$s used by connected devices in the last %2$s — limit %3$s reached</string>
    <string name="enforce_hotspot">Turn the hotspot off automatically when the limit is exceeded</string>
    <string name="enforce_hotspot_note">Automatic hotspot shutdown is not available on this device — Android does not let apps turn the access point on/off directly. When the limit is exceeded, the app cuts the internet for the connected devices with a built-in kill switch (VPN) and also tries the direct stop; the exact result is shown in the notification.</string>

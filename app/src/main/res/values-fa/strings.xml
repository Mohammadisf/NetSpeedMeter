    <!-- Data limit enforcement (automatic disconnection) -->
    <string name="enforce_limits">قطع خودکار اتصال هنگام عبور از سقف مصرف</string>
    <string name="enforce_unsupported_note">در این دستگاه امکان قطع مستقیم اتصال وجود ندارد — اندروید اجازه نمی‌دهد برنامه‌ها اتصال‌های شبکه را مستقیماً روشن/خاموش کنند. پس از عبور از سقف، برنامه اینترنت دستگاه را با کلید قطع داخلی (VPN) مسدود می‌کند تا چیزی نتواند به مصرف داده ادامه دهد. یک بار برای آن اجازه اتصال VPN گرفته می‌شود.</string>
    <string name="limit_notif_title">سقف مصرف پیموده شد</string>
    <string name="limit_notif_text">سقف %1$s پیموده شد — مصرف %2$s از %3$s</string>
    <string name="limit_disconnected"> اتصال به‌صورت خودکار قطع شد.</string>
    <string name="limit_blocked_vpn"> اینترنت به‌صورت خودکار مسدود شد (کلید قطع داخلی).</string>
    <string name="limit_disconnect_failed"> در این دستگاه قطع خودکار ممکن نبود — لطفاً دستی قطع کنید.</string>
    <string name="limit_monitor_hint">پایش تا زمانی که سرویس سرعت فعال است ادامه دارد. هر سقف پس از پایان بازه‌اش دوباره فعال می‌شود.</string>

    <!-- Enforcement kill-switch VPN -->
    <string name="enforce_vpn_channel">اجرای سقف مصرف</string>
    <string name="enforce_vpn_session">اجرای سقف مصرف NetSpeed Meter</string>
    <string name="enforce_vpn_notif_title">اینترنت مسدود شد — سقف مصرف پیموده شد</string>
    <string name="enforce_vpn_notif_text">سقف مصرفی پیموده شده است. اینترنت تا زمانی که «بازگرداندن» را بزنید مسدود می‌ماند.</string>
    <string name="restore_internet">بازگرداندن اینترنت</string>

    <!-- Hotspot limit -->
    <string name="hotspot_limit">تعیین سقف‌های هات‌اسپات</string>
    <string name="hotspot_limit_label">سقف مصرف هات‌اسپات (مگابایت)</string>
    <string name="hotspot_message">وقتی دستگاه‌های متصل به هات‌اسپات شما در بازه زمانی انتخابی بیش از سقف مصرف کنند، اعلان هشدار نشان داده می‌شود. برای غیرفعال کردن، فیلد را خالی یا 0 بگذارید.</string>
    <string name="hotspot_alert_title">هشدار مصرف هات‌اسپات</string>
    <string name="hotspot_usage_note">شمارنده‌های مصرف هات‌اسپات در برخی نسخه‌های اندروید (مثلاً اندروید ۱۶) از برنامه‌ها پنهان است؛ برنامه در آن حالت مصرف هات‌اسپات را از طریق «دسترسی به داده مصرف» سیستم می‌خواند. یک بار اجازه آن از شما گرفته می‌شود.</string>
    <string name="hotspot_alert_text">مصرف %1$s توسط دستگاه‌های متصل در %2$s گذشته — از سقف %3$s عبور شد</string>
    <string name="enforce_hotspot">خاموش کردن خودکار هات‌اسپات هنگام عبور از سقف مصرف</string>
    <string name="enforce_hotspot_note">خاموش کردن خودکار هات‌اسپات در این دستگاه در دسترس نیست — اندروید اجازه نمی‌دهد برنامه‌ها نقطه دسترسی را مستقیماً روشن/خاموش کنند. پس از عبور از سقف، برنامه اینترنت دستگاه‌های متصل را با کلید قطع داخلی (VPN) قطع می‌کند و همچنین خاموش کردن مستقیم را هم امتحان می‌کند؛ نتیجه دقیق در اعلان اعلام می‌شود.</string>
    <string name="limit_hotspot_blocked_vpn"> اینترنت دستگاه‌های متصل به هات‌اسپات به‌صورت خودکار قطع شد (کلید قطع داخلی)؛ اندروید اجازه خاموش کردن خودِ نقطه دسترسی را نمی‌دهد.</string>
